# Local-only heuristic simulation by default. No model requests are made.
# Muse can be re-enabled only by setting both opt-in flags and a server-side key.
EVIDENCETRAIL_PROVIDER=mock
EVIDENCETRAIL_ENABLE_MUSE=false
MUSE_REASONING_EFFORT=minimal
MODEL_API_KEY=add_your_meta_model_api_key
MAX_PDF_MB=12
MAX_PDF_PAGES=20
MAX_ANALYSES_PER_PROCESS=20
MAX_ANALYSES_PER_HOUR_PER_IP=5
MAX_CONCURRENT_ANALYSES=5
# Enable only when this app is served behind Cloudflare/Render's edge proxy.
EVIDENCETRAIL_TRUST_CF_CONNECTING_IP=false
